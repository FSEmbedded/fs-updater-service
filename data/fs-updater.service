[Unit]
Description=F&S Update Framework D-Bus Service
Documentation=https://github.com/FSEmbedded/fs-updater-service
Requires=dbus.service
Wants=rauc.service
After=dbus.service rauc.service
Before=deviceupdate-agent.service
# The boot-time confirm chain writes the same durable update state this daemon
# does. It deliberately does NOT depend on the daemon -- it runs before this
# unit is necessarily up, and making it wait would put a D-Bus dependency in
# the boot path. The reverse ordering costs nothing and states which of the two
# is expected to have finished first, so a caller reaching the bus does not
# race a confirm still deciding. What makes the two converge regardless is not
# this line: every write goes through the environment library, which takes a
# blocking lock around it. The ordering records the intent; the lock is the
# guarantee. On an image without the confirm chain the ordering is inert.
After=fus-update-confirm.service

[Service]
Type=dbus
BusName=de.fsembedded.fsupdate1
ExecStart=/usr/sbin/fs-updater-service
Restart=on-failure
RestartSec=5
User=root

# Resource & scheduling tuning. Defaults are sized for single-core
# targets where every PropertiesChanged emission steals CPU from the
# install worker; multi-core BSPs can lift the limits via drop-in at
# /etc/systemd/system/fs-updater.service.d/board.conf.
#
#   Nice=5             keeps property reads responsive while the
#                      worker drives RAUC; the worker drops
#                      further via FSUPDATE_WORKER_NICE.
#   CPUWeight=50       moderate share; system services stay snappy.
#   IOSchedulingClass=best-effort + Prio=7  RAUC/eMMC writes don't
#                      starve other consumers.
#   OOMScoreAdjust=-500  install survives memory pressure rather
#                      than getting killed mid-write.
#   MemoryHigh/Max     forces v2.0 streaming behaviour — a bundle
#                      staged on tmpfs hits the ceiling and fails
#                      loudly, surfacing config mistakes early.
#                      BSPs still on v1.0 containers must override.
#   LimitNOFILE=4096   sd-bus + RAUC subscriptions + lib fds.
Nice=5
CPUWeight=50
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMScoreAdjust=-500
MemoryHigh=128M
MemoryMax=256M
LimitNOFILE=4096

# Worker-tuning knobs (FSUPDATE_*) are read at service construction; see
# service.h and hawkbit_service.h for their meaning. Override per-board via the
# drop-in file above.
Environment=FSUPDATE_PROGRESS_MS=250
Environment=FSUPDATE_WORKER_NICE=5
Environment=FSUPDATE_WORKER_IOPRIO=7
Environment=FSUPDATE_INHIBIT_SLEEP=1
Environment=FSUPDATE_INSTALL_TIMEOUT_SEC=1800

[Install]
WantedBy=multi-user.target
